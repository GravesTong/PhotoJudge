      "dimension": "COMP",
      "impact": "medium",
      "reason": "主体居中偏呆板，未落三分点",
      "action": "主体贴边或居中呆板时，把主体挪到四个三分交叉点之一；新手先开相机九宫格辅助线。",
      "conflicts": null
    },
    {
      "rule_id": "FOC-001",
      "dimension": "FOC",
      "impact": "medium",
      "reason": "人像对焦落在鼻尖而非眼睛",
      "action": "要背景虚化不仅靠大光圈，用长焦+近距离更明显；要大景深可用广角端；拍特写/微距必须精确对焦。",
      "conflicts": null
    },
    {
      "rule_id": "PPC-009",
      "dimension": "PPC",
      "impact": "low",
      "reason": "手机端需补校色流程",
      "action": "手机校色流程=Edit>Light（五滑块）→Color（Temp/Tint/Vibrance/Saturation）→Color>Mix（HSL）→Effects（Texture/Clarity/Dehaze）→Detail（Sharpen/Noise）→Optics（Lens 校正）。给新手建议时，手机=醒图/VSCO 同名滑块直接用；电脑=LR 五滑块+HSL+Detail。",
      "conflicts": null
    }
